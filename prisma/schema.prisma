generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("SEARCHFLIX_PRISMA_DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  favorites Favorite[]
}

model Favorite {
  id       Int     @id @default(autoincrement())
  movieId  Int
  ehSerie  Boolean @default(false)
  userId   Int
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}
